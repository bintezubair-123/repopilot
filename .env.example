# --- LLM (used from step 2 onward; LiteLLM reads the provider key automatically) ---
# Check your provider's pricing page for the current free-tier model names.
LLM_MODEL=gemini/gemini-2.5-flash
GEMINI_API_KEY=
# Alternative provider:
# LLM_MODEL=groq/llama-3.3-70b-versatile
# GROQ_API_KEY=
LLM_MAX_RETRIES=5

# --- RAG ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHROMA_DIR=.repopilot/chroma
TOP_K=6

# --- PR review ---
# Diffs longer than this are truncated (files that don't fit are listed in the PR comment)
MAX_DIFF_CHARS=24000

# --- Misc ---
LOG_LEVEL=INFO

# Optional: override the built-in agents.yaml / tasks.yaml (defaults to src/repopilot/config)
# REPOPILOT_CONFIG_DIR=
